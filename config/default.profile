# Configurazione profilo GestioneFoto
ProfileName=default
MinSize=1024
UserName=%USERNAME%
IncludePath=c:\Users\%USERNAME%\Pictures
ExcludePaths=
Extensions=jpg,jpeg,png,gif,bmp,tif,tiff,webp,mp4,avi,mov,mkv,wmv,flv,webm,m4v,3gp,mpg,mpeg,nef,m2ts
DestinationRoot=C:\Mediabackup\%USERNAME%\backup
DatabasePath=C:\Mediabackup\%USERNAME%\GestioneFoto.db
DestinationTemplate=YYYY/MM/DD
AlbumDestination=C:\Mediabackup\%USERNAME%\Album