{
  "name": "gestione-foto-3",
  "version": "3.0.0",
  "private": true,
  "description": "Server locale per Gestione Foto",
  "type": "module",
  "main": "src/electron-main.js",
  "scripts": {
    "server": "node src/server.js",
    "test": "node --test",
    "main-fisso": "node --max-old-space-size=4096 src/main-fisso.js",
    "web": "node src/web-server.cjs",
    "scan-cli": "node src/scan-cli.cjs --verbose --batch-size=100 --min-size=4096 --name=giuliano --source-dir=D:\\ --dest-dir=F:\\ArchivioFoto",
    "electron": "electron .",
    "build": "electron-builder"
  },
  "files": [
      "src/**/*",
      "package.json"
    ],
  "dependencies": {
    "bmp-js": "^0.1.0",
    "exifr": "^7.1.3",
    "express": "^5.3.0",
    "sharp": "^0.35.5",
    "sqlite3": "^6.0.1"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0"
  }
}
