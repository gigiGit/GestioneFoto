{
  "name": "gestione-foto-3",
  "version": "3.0.0",
  "private": true,
  "description": "Server locale per Gestione Foto",
  "type": "module",
  "main": "src/electron-main.js",
  "scripts": {
    "server": "node src/server.js",
    "test": "node --test",
    "main-fisso": "node --max-old-space-size=6096 src/main-fisso.js",
    "main": "node --max-old-space-size=6096 src/main.js",
    "web": "node src/web-server.cjs",
    "scan-cli": "node src/scan-cli.cjs --verbose --batch-size=100 --min-size=4096 --name=giuliano --source-dir=D:\\ --dest-dir=F:\\ArchivioFoto",
    "electron": "electron .",
    "build": "electron-builder"
  },
  "files": [
    "src/**/*",
    "package.json"
  ],
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "bmp-js": "^0.1.0",
    "exifr": "^7.1.3",
    "express": "^5.3.0",
    "node-gyp": "^13.1.0",
    "rebuild": "^0.1.2",
    "sharp": "^0.35.5"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "sqlite3@6.0.1": true,
    "better-sqlite3@13.2.0": true
  }
}
